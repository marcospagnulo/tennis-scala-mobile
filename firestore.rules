rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Stagioni
    match /seasons/{document=**} {
      allow read: if true;  // Chiunque può leggere
      allow create: if request.auth != null && 
                       request.auth.token.role == "admin";  // Solo admin creano
      allow update: if request.auth != null;  // Player autenticati possono modificare
      allow delete: if request.auth != null && 
                       request.auth.token.role == "admin";  // Solo admin eliminano
    }
    
    // Giocatori
    match /players/{playerId} {
      allow read: if true;  // Chiunque può leggere
      allow create: if request.auth != null;  // Utenti autenticati creano
      allow update: if request.auth != null;  // Utenti autenticati aggiornano
      allow delete: if request.auth != null && 
                       request.auth.token.role == "admin";  // Solo admin eliminano
    }
  }
}
